{
  "name": "esbuild-plugin-browserslist",
  "version": "4.0.0",
  "description": "Configure esbuild's target based on a browserslist query",
  "license": "MIT",
  "author": "Nihal Gonsalves <nihal@nihalgonsalves.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/nihalgonsalves/esbuild-plugin-browserslist.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc",
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "test": "vitest",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepublishOnly": "node --run build && node --run lint && node --run test -- --no-watch"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nihalgonsalves/esconfig": "^0.18.2",
    "@types/debug": "^4.1.13",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "browserslist": "^4.28.9",
    "esbuild": "~0.28.2",
    "knip": "^6.34.0",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "browserslist": "^4.28.9",
    "esbuild": "~0.28.2"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.11.0"
}
